# Copy this file to .env and fill in real values. Every variable below is read by src/config.ts.

# --- Server ---
PORT=3000
HOCUSPOCUS_PORT=3001
PROVIDER_ADDRESS=ws://localhost:3002
DOMAIN=localhost
ADDR_PREFIX=
DEV_MODE=true

# --- Database ---
ARCHIVIUM_DB_HOST=localhost
ARCHIVIUM_DB_USER=archivium
ARCHIVIUM_DB_PASSWORD=changeme
ARCHIVIUM_DB=archivium

# --- Email ---
SITE_OWNER_EMAIL=owner@example.com
MAILERSEND_API_KEY=

# --- Third-party services ---
OPENAI_API_KEY=
RECAPTCHA_KEY=

# --- Web Push notifications (optional; leave WEB_PUSH_ENABLED=false to disable) ---
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Semantic search (optional) ---
# Semantic search (related items, search page matches, etc.) is disabled unless
# EMBEDDING_API_URL is set. When unset, none of that code tries to reach Qdrant or
# an embedding server - safe to leave blank for local dev or CI (e.g. Cypress).
#
# EMBEDDING_API_URL should point at an OpenAI-compatible /v1/embeddings endpoint.
# LMSTER_KEY is the bearer token sent to that endpoint.
EMBEDDING_API_URL=
LMSTER_KEY=
# QDRANT_URL defaults to http://localhost:6333 if unset, matching `npm run qdrant:up`
# (see docker-compose.yml). Only needs to be set if Qdrant is hosted elsewhere.
QDRANT_URL=
