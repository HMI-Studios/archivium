block append styles
  style.
    #note-list .card>.preview-body {
      white-space: nowrap;
      overflow: hidden;
      mask-image: linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 1) 85%, rgba(0, 0, 0, 0) 97%);
    }

div
  p.ma-0.pa-1
    a.link.link-animated#create-note #{T('Create Note')}

  #note-list.card-list
    input(id='search' name='search' placeholder='Search...')
    each note in notes
      .sheet.card.d-flex.flex-col.gap-1(data-uuid=note.uuid data-note=note)
        .d-flex.align-start.justify-between
          h2.ma-0 #{note.title}
          a.edit-link.link.link-animated.d-flex.align-center
            span.material-symbols-outlined(style={ 'font-size': '1rem' }) edit
            |  #{T('Edit')}
        small
          b #{T('Author')}: 
          a.link.link-animated(href=`/users/${noteAuthors[note.author_id].username}`) #{noteAuthors[note.author_id].username}
          |  — 
          b #{T('Updated')}: 
          | #{formatDate(note.updated_at)}
        span.preview-body
        .rendered-body.hidden
          .d-flex.justify-center.pa-4
            .loader
        if note.tags
          small.d-flex.flex-wrap.gap-1.tags
            each noteTag in note.tags
              if noteTag
                a.link.link-animated(data-tag=noteTag) ##{noteTag}

  script.
    (async function() {
      if (!window.createElement) throw 'domUtils not loaded!';
      if (!window.getJSON) throw 'fetchUtils.js not loaded!';

      const newNoteLink = document.querySelector('#create-note');
      newNoteLink.addEventListener('click', async () => {
        const uuid = await postJSON('#{noteBaseRoute}', {
          title: '',
          is_public: false,
        });

        const linkQuery = new URLSearchParams();
        linkQuery.append('returnTo', `${location.pathname}${location.search}${location.hash}`);
        window.location.href = `/notes/${uuid}?${linkQuery.toString()}`;
      });

      const noteList = document.querySelector('#note-list');
      const searchBar = noteList.querySelector('#search');

      const fetchedNotes = {};
      let currentOpenUuid = null;
      async function toggleNote(uuid) {
        if (currentOpenUuid) {
          const noteCard = noteList.querySelector(`.card[data-uuid="${currentOpenUuid}"]`);
          const preview = noteCard.querySelector('.preview-body');
          const rendered = noteCard.querySelector('.rendered-body');
          preview.classList.remove('hidden');
          rendered.classList.add('hidden');
        }

        const query = new URLSearchParams(window.location.search);
        if (currentOpenUuid === uuid) {
          currentOpenUuid = null;
          query.delete('note');
          const { protocol, host, pathname, hash } = window.location;
          const newurl = `${protocol}//${host}${pathname}?${query.toString()}${hash}`;
          window.history.replaceState(null, '', newurl);
          return;
        };
        currentOpenUuid = uuid;

        query.set('note', uuid);
        const { protocol, host, pathname, hash } = window.location;
        const newurl = `${protocol}//${host}${pathname}?${query.toString()}${hash}`;
        window.history.replaceState(null, '', newurl);

        noteList.querySelectorAll('.card').forEach((el) => {
          const editLink = el.querySelector('.edit-link');
          const linkQuery = new URLSearchParams();
          linkQuery.append('returnTo', `${location.pathname}${location.search}${location.hash}`);
          editLink.href = `/notes/${el.dataset.uuid}?${linkQuery.toString()}`;
        });

        const noteCard = noteList.querySelector(`.card[data-uuid="${uuid}"]`);
        const preview = noteCard.querySelector('.preview-body');
        const rendered = noteCard.querySelector('.rendered-body');
        preview.scrollIntoViewIfNeeded({ block: 'center' });
        preview.classList.add('hidden');
        rendered.classList.remove('hidden');
        if (uuid in fetchedNotes) return;
        const noteData = await (await fetch(`#{noteBaseRoute}/${uuid}?renderBody=1`)).json();
        const bodyHTML = noteData.body.content;
        rendered.innerHTML = bodyHTML;
        fetchedNotes[uuid] = true;
      }

      const noteCards = noteList.querySelectorAll('.card');
      const noteTags = {};
      const tagLinks = {};
      let currentTagFilter = null;
      function filterByTag(tag) {
        if (tag === currentTagFilter) tag = null;
        currentTagFilter = tag;
        noteList.querySelectorAll('.card .tags a').forEach(tagLink => tagLink.classList.remove('link-selected'));
        tagLinks[tag]?.forEach(tagLink => tagLink.classList.add('link-selected'));
        noteCards.forEach(card => {
          if (noteTags[card.dataset.uuid][tag] || tag === null) card.classList.remove('hidden');
          else card.classList.add('hidden');
        });

        const query = new URLSearchParams(window.location.search);
        if (tag) query.set('note_tag', tag);
        else query.delete('note_tag');
        const { protocol, host, pathname, hash } = window.location;
        const newurl = `${protocol}//${host}${pathname}?${query.toString()}${hash}`;
        window.history.pushState({ path: newurl }, '', newurl);
      }
      noteCards.forEach(card => {
        noteTags[card.dataset.uuid] = {};
        card.querySelectorAll('.tags a').forEach(tagLink => {
          const tag = tagLink.dataset.tag;
          noteTags[card.dataset.uuid][tag] = true;
          if (!(tag in tagLinks)) tagLinks[tag] = [];
          tagLinks[tag].push(tagLink);
          tagLink.addEventListener('click', e => {
            e.stopPropagation();
            filterByTag(tag);
          });
        });
      });

      searchBar.addEventListener('change', () => {
        noteList.querySelectorAll('.card').forEach((el) => {
          const { title, body } = JSON.parse(el.dataset.note);
          el.classList.toggle('hidden', title.toLowerCase().indexOf(searchBar.value.toLowerCase()) === -1 && body.toLowerCase().indexOf(searchBar.value.toLowerCase()) === -1);
        });
      });

      noteList.querySelectorAll('.card').forEach((el) => {
        el.addEventListener('click', () => {
          toggleNote(el.dataset.uuid);
        });
        const rendered = el.querySelector('.rendered-body');
        rendered.addEventListener('click', (e) => e.stopPropagation());
        const editLink = el.querySelector('.edit-link');
        editLink.addEventListener('click', (e) => e.stopPropagation());
        const linkQuery = new URLSearchParams();
        linkQuery.append('returnTo', `${location.pathname}${location.search}${location.hash}`);
        editLink.href = `/notes/${el.dataset.uuid}?${linkQuery.toString()}`;
      });

      window.addEventListener('load', async () => {
        const query = new URLSearchParams(window.location.search);
        const uuid = query.get('note');
        if (uuid) {
          await toggleNote(uuid);
          const hash = location.hash.substr(1);
          if (hash) {
            const el = document.getElementById(hash);
            if (el) {
              el.scrollIntoView();
            }
          }
        }
        const tag = query.get('note_tag');
        if (tag) {
          filterByTag(tag);
        }
      });


      document.querySelectorAll('#note-list .card').forEach(async (el) => {
        const previewBody = el.querySelector('.preview-body');
        const text = JSON.parse(el.dataset.note).body?.replaceAll('\n', ' ') ?? '';
        const maxLength = 255;
        previewBody.innerText = text.length >= maxLength ? `${text.substring(0, maxLength)}...` : text;
      });
    })();
