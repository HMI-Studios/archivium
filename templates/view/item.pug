extends ../layout.pug

block title
  title #{item.title}

block append styles
  link(rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css")
  style.
    #links-display {
      visibility: hidden;
      transition: max-height 0.33s;
    }

block scripts
  script(src="https://unpkg.com/easymde/dist/easymde.min.js")
  script
    include /static/scripts/tabs.js
    include /static/scripts/domUtils.js
    include /static/scripts/fetchUtils.js
    include /static/scripts/markdown/parse.js
    include /static/scripts/markdown/render.js
    include /static/scripts/modal.js
    include /static/scripts/searchableSelect.js
    include /static/scripts/editor/markdown.js
    include /static/scripts/calendarPicker.js
    include /static/scripts/timelineRender.js
    include /static/scripts/cardUtils.js
    include /static/scripts/easyMDE.js

block breadcrumbs
  -
    const universeItemsLink = systemDisplayModes.includes(displayUniverse)
      ? `/${displayUniverse}`
      : `${universeLink(universe.shortname)}/items`;
  if displayUniverse
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{systemDisplayModes.includes(displayUniverse) ? T('Home') : universe.title}
  else
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{T('Home')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes`) #{T('Universes')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes/${universe.shortname}`) #{universe.title}
  |  / 
  if item.item_type !== '_special'
    a.link.link-animated(href=`${universeItemsLink}?type=${item.item_type}`) #{capitalize(T(`${((universe.obj_data.cats || {})[item.item_type] || [, 'Missing Category'])[1]}`))}
    |  / 
  span #{item.title}

block content
  .d-flex.justify-center
    .sheet.overflow-hidden.mt-8.px-8.py-4(style={ 'position': 'relative', 'min-width': '15vw' })
      .card-backdrop(style={ 'background-color': item.itemTypeColor })
      .card-text
        h1.center.ma-0 #{item.title}
        if item.item_type !== '_special'
          p.center.ma-0 #{capitalize(T(item.itemTypeName))}
            if !displayUniverse
              |  of #{item.universe}
        else
          p.center.ma-0 of #{item.universe}
  p.center.mb-2
    small #{T('Created by ')}
      if item.author
        a.link.link-animated(href=`${ADDR_PREFIX}/users/${item.author}`) #{item.author}
      else
        | #{T('Deleted User')}
      |  #{formatDate(new Date(item.created_at))}
      |  - Last updated #{formatDate(new Date(item.updated_at))}
  #action-bar.d-flex.justify-center.align-center.gap-2.mb-1
    if contextUser
      a.link.d-flex.align-center
        span#notification-bell.material-symbols-outlined.mr-1(
          title='Item Notifications'
          class={ solid: item.notifs_enabled }
        ) #{item.notifs_enabled ? 'notifications_active' : 'notifications'}
        span#subscribe-text #{item.notifs_enabled ? 'Unsubscribe' : 'Subscribe'}
      script.
        (() => {
          let isSubscribed = #{item.notifs_enabled};
          const bell = document.getElementById('notification-bell');
          const text = document.getElementById('subscribe-text');
          bell.parentElement.addEventListener('click', async () => {
            isSubscribed = !isSubscribed;
            bell.classList.add('disabled');
            try {
              await putJSON(`/api/universes/${universe.shortname}/items/${item.shortname}/subscribe`, { isSubscribed: isSubscribed });
            } catch (err) {
              console.error(err);
              isSubscribed = !isSubscribed;
            } finally {
              bell.textContent = isSubscribed ? 'notifications_active' : 'notifications';
              bell.classList.toggle('solid', isSubscribed);
              bell.classList.remove('disabled');
              text.textContent = isSubscribed ? 'Unsubscribe' : 'Subscribe';
            }
          });
        })();
      if universe.author_permissions[contextUser.id] >= perms.WRITE
        a.link.link-animated.d-flex.align-center(href=`${ADDR_PREFIX}/editor/universes/${universe.shortname}/items/${item.shortname}`)
          span.material-symbols-outlined edit
          |  #{T('Edit')}
      if universe.author_permissions[contextUser.id] >= perms.OWNER
        a.link.link-animated.d-flex.align-center(href=`${universeLink(universe.shortname)}/items/${item.shortname}/delete`)
          span.material-symbols-outlined delete
          |  #{T('Delete')}
  .center#tags
    small
      if item.tags
        each tag in item.tags
          if tag
            a.link.link-animated(href=`${universeItemsLink}?tag=${tag}`) ##{tag} 
  .center#links
    small #{T('Linked to by %s items', item.links.length)} (
      a.link.link-animated#show-links #{T('show')}
      | ).
    ul#links-display.d-flex.gap-2.justify-center.flex-wrap.ma-0.pa-0.pt-1.overflow-hidden
      each link in item.links
        li.navbarBtn
          if link.universe_short === item.universe_short
            a.link.link-animated(href=`${universeItemsLink}/${link.shortname}`) #{link.title}
          else
            a.link.link-animated(href=`/universes/${link.universe_short}/items/${link.shortname}`) #{link.title}
    script.
      (() => {
        const display = document.querySelector('#links-display');
        const showBtn = document.querySelector('#show-links');
        const height = display.getBoundingClientRect().height;
        let isVisible = false;
        display.style.maxHeight = 0;
        display.style.visibility = 'visible';
        showBtn.addEventListener('click', () => {
          isVisible = !isVisible;
          showBtn.textContent = isVisible ? T('hide') : T('show')
          display.style.maxHeight = isVisible ? `${height}px` : 0;
        });
      })();

  hr

  //- Tab buttons
  ul#tabBtns.navbarBtns.gap-1.mb-2.scroll-x
    if 'body' in item.obj_data
      li.navbarBtn#bodyBtn(data-tab='body')
        h3.navbarBtnLink.navbarText(onclick=`showTab('body')`) #{T('Main Text')}
    if 'tabs' in item.obj_data
      each tab, name in item.obj_data.tabs
        li.navbarBtn(data-tab=name)
          h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('${name}')`) #{name}
    each dataType in ['timeline', 'gallery', 'lineage', 'map']
      if dataType in item.obj_data && 'title' in item.obj_data[dataType]
        li.navbarBtn(data-tab=dataType)
          h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('${dataType}')`) #{item.obj_data[dataType].title}
    if item.obj_data.notes || (contextUser && universe.author_permissions[contextUser.id] >= perms.WRITE && notes.length > 0)
      li.navbarBtn(data-tab='notes')
        h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('notes')`) #{capitalize(T('notes'))}
          if !item.obj_data.notes
            |  #{T('(Hidden)')}


  #data(data-item=item data-universe=universe)
  script.
    var { item, universe } = document.querySelector('#data').dataset;
    item = JSON.parse(item);
    universe = JSON.parse(universe);

  .tabs
    if 'tabs' in item.obj_data
      each tab, name in item.obj_data.tabs
        .itemTab.hidden(data-tab=name)
          each val, key in tab
            .itemKey
              span #{key}
              hr
              .mdVal(data-val=val)

    if 'timeline' in item.obj_data && 'title' in item.obj_data.timeline
      .itemTab.hidden(data-tab='timeline')
      script.
        const timelineTab = document.querySelector('.itemTab[data-tab=timeline]');
        if (timelineTab) {
          renderTimeline(timelineTab, item, item.events);
        };

    if 'gallery' in item.obj_data && 'title' in item.obj_data.gallery
      .itemTab.hidden.gallery(data-tab='gallery')
        each img in item.gallery || []
          .itemKey
            img(src=`/api/universes/${universe.shortname}/items/${item.shortname}/gallery/images/${img.id}`, title=img.name, alt=img.label)
            if img.label
              .mdLabel(data-val=img.label)

      #gallery-fullscreen-modal

    if 'lineage' in item.obj_data && 'title' in item.obj_data.lineage && familyLayout
      .hidden(data-tab='lineage')
        style.
          #family-grid {
            display: flex;
          }

          .me {
            border: 0.25rem outset gold;
          }

          .children-bar {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: -1;
            margin: 0 1rem;
            border-top: 0.125rem solid black;
          }

          .parent-bar {
            position: absolute;
            top: -50%;
            left: 50%;
            width: 0;
            height: calc(50% + 1rem);
            z-index: -1;
            border-right: 0.125rem solid black;
          }

          .parent-corner {
            top: calc(-50% + 1rem);
            height: 50%;
          }

          .parent-corner-right {
            left: calc(50% - 0.125rem);
          }

          .corner-bar {
            position: absolute;
            top: -50%;
            left: 50%;
            width: 1rem;
            height: 1rem;
            z-index: -1;
            border-top: 0.125rem solid black;
          }

          .family-col {
            display: flex;
            flex-direction: column;
            min-width: 14rem;
            margin-right: -7rem;
          }

          .family-cell {
            position: relative;
            height: 7rem;
          }
        .scroll-x
          #family-grid
            -
              const grid = new Array(familyLayout.width-1).fill(null).map(r => []);
              function ensureRows(col, requestedRow) {
                while (requestedRow >= grid[col-1].length) {
                  grid[col-1].push([null, null, [false, false, false], null]);
                }
              }
              for (const member in familyLayout.members) {
                const { row, col, cStart, cEnd } = familyLayout.members[member];
                ensureRows(col, row);
                grid[col-1][row][0] = member;
                if (cStart !== undefined) {
                  ensureRows(cStart, row);
                  grid[cStart-1][row][1] = cEnd - cStart;

                  for (const { child_shortname } of family[member].children) {
                    if (child_shortname in familyLayout.members) {
                      const childCol = familyLayout.members[child_shortname].col;
                      const isCorner = cStart !== cEnd && childCol === cStart || childCol === cEnd;
                      const isLeft = childCol === cStart;
                      ensureRows(childCol, row+1);
                      grid[childCol-1][row+1][2] = [true, isCorner, isLeft];
                    }
                  }
                }
              }
              for (const { child_shortname, child_label } of family[item.shortname].children) {
                if (child_shortname in familyLayout.members) {
                  const { row, col } = familyLayout.members[child_shortname];
                  grid[col-1][row][3] = child_label || T('Child');
                }
              }
              for (const { parent_shortname, parent_label } of family[item.shortname].parents) {
                if (parent_shortname in familyLayout.members) {
                  const { row, col } = familyLayout.members[parent_shortname];
                  grid[col-1][row][3] = parent_label || T('Child');
                }
              }

            each column in grid
              .family-col
                each row in column
                  .family-cell
                    if row[0]
                      .sheet.ma-2(class={ 'me': row[0] === item.shortname })
                        a.link.link-animated(href=`${universeItemsLink}/${row[0]}?tab=lineage`)
                          | #{family[row[0]].title}
                        if row[3]
                          hr.my-1
                          small #{row[3]}
                    if row[1]
                      .children-bar(style={ 'width': `${(row[1] * 7) - 2}rem` })
                    if row[2][0]
                      .parent-bar(class={ 'parent-corner': row[2][1], 'parent-corner-right': row[2][1] && !row[2][2] })
                      if row[2][1]
                        .corner-bar(
                          style={
                            [`border-${row[2][2] ? 'left' : 'right'}`]: '0.125rem solid black',
                            'border-radius': row[2][2] ? '1rem 0' : '0 1rem',
                            'left': row[2][2] ? '50%' : 'calc(50% - 1rem)',
                          }
                        )

            script.
              window.addEventListener('load', () => {
                document.querySelector('#family-grid .me').scrollIntoView({ inline: 'center' });
              });

    if 'map' in item.obj_data && 'title' in item.obj_data.map
      .itemTab.hidden(data-tab='map')
        #map-display.w-100
          .map-container.d-flex.flex-col.pa-2(class={ square: item.map.image_id === null })
            if item.map.image_id
              img(src=`/api/universes/${universe.shortname}/items/${item.shortname}/map/image`)
            if item.map
              each location in item.map.locations
                button.map-location(style={ top: `calc(${location.y * 100}% - ${location.y}rem)`, left: `calc(${location.x * 100}% - ${location.x}rem)` })
                  if location.item && location.universe
                    a.link.link-animated(
                      href=`${universeLink(location.universe)}/items/${location.item}`
                      class={ right: location.x <= 0.5, left: location.x > 0.5  }
                    ) #{location.title || location.itemTitle}
                  else
                    label(class={ right: location.x <= 0.5, left: location.x > 0.5  }) #{location.title || 'Untitled Location'}

    if item.obj_data.notes || (contextUser && universe.author_permissions[contextUser.id] >= perms.WRITE && notes.length > 0)
      .hidden(data-tab='notes')
        if !item.obj_data.notes
          .center
            .ma-auto.my-2(style={ 'max-width': '32rem' })
              small
                i #{T('This tab is visible to you since this item has notes linked to it and you have edit access.')}
                  | #{T('To make this tab visible to everyone, enable notes for this item.')}
        include ../components/notes.pug

    if 'body' in item.obj_data
      .sheet.hidden(data-tab='body')
        if renderedBody.type === 'html'
          .markdown !{renderedBody.content}
        else
          .markdown #{renderedBody.content}

  -
    const showComments = !!item.obj_data.comments;
    const showRelatedItems = relatedItems && relatedItems.length > 0;
  if showComments || showRelatedItems
    .related-comments-grid(class={ 'single-column': !showComments || !showRelatedItems })
      if showComments
        div
          h2 #{T('Comments')}
          div
            -
              const canComment = contextUser && universe.discussion_enabled && (
                (universe.is_public && universe.discussion_open)
                || (universe.author_permissions[contextUser.id] >= (universe.discussion_open ? perms.READ : perms.COMMENT))
              );
              const canDelete = contextUser && universe.author_permissions[contextUser.id] >= perms.ADMIN;
              const apiRoute = `/api/universes/${universe.shortname}/items/${item.shortname}/comments`;
              const universeShortname = universe.shortname;
            if !universe.discussion_enabled
              .center
                .ma-auto.my-2(style={ 'max-width': '32rem' })
                  small
                    i #{T(`Discussion and comments is disabled for ${universe.title}.`)}
                      |  #{T('To allow leaving comments, enable discussion on the ')}
                      a.link.link-animated(href=`${universeLink(universe.shortname)}/edit`) #{T('universe edit page')}.
            include ../components/comments.pug
      if showRelatedItems
        div
          h2 #{T('Related Items')}
          include ../components/relatedItems.pug

  script.
    (() => {
      tabLoadPromise.then(() => {
        const hash = location.hash.substr(1);
        if (hash) {
          const el = document.getElementById(hash);
          if (el) {
            el.scrollIntoView();
          }
        }
      });

      document.querySelectorAll('.mdVal').forEach((el) => {
        loadMarkdown(el, '#{universe.shortname}', el.dataset.val, null, (tag) => {
          if (tag.type === 'div') tag.attrs.style = {'text-align': 'right'};
          if (tag.type === 'p') tag.type = 'span';
        });
      });

      document.querySelectorAll('.mdLabel').forEach((el) => {
        loadMarkdown(el, '#{universe.shortname}', el.dataset.val, null, (tag) => {
          if (tag.type === 'div') {
            tag.attrs.style = {'text-align': 'center'};
            tag.attrs.class += ' label';
          }
          if (tag.type === 'p') tag.type = 'span';
        });
      });

      const galleryItems = document.querySelectorAll('.gallery .itemKey');
      loadModal('gallery-fullscreen-modal');
      galleryItems.forEach((itemKey) => {
        const img = itemKey.querySelector('img');

        img.onclick = (e) => {
          e.stopPropagation();
          const content = itemKey.cloneNode(true);
          content.classList.remove('itemKey');
          replaceContent('gallery-fullscreen-modal', content);
          showModal('gallery-fullscreen-modal');
          setOnClose('gallery-fullscreen-modal', () => {
            hideModal('gallery-fullscreen-modal');
          });
        };
      });
    })();
